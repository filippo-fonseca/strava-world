# Strava API (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Random secret for encrypted session cookies (32+ chars)
# Generate: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-secret

# Canonical public origin — used for Strava OAuth redirect_uri.
# Must match Strava "Authorization Callback Domain" (host only in Strava UI).
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# Production example:
# NEXT_PUBLIC_APP_URL=https://stravaworld.hyperpolymath.com
#
# Optional full callback override (defaults to NEXT_PUBLIC_APP_URL/api/auth/callback):
# STRAVA_REDIRECT_URI=https://stravaworld.hyperpolymath.com/api/auth/callback
