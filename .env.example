# Strava API (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Random secret for encrypted session cookies (32+ chars)
# Generate: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-secret

# Optional overrides (auto-detected from the request on Vercel)
# Local:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/callback
#
# Production (Vercel):
# NEXT_PUBLIC_APP_URL=https://strava-world-six.vercel.app
# STRAVA_REDIRECT_URI=https://strava-world-six.vercel.app/api/auth/callback
